# Strict: every enabled check is enforced (warnings are errors). Checks are
# disabled only with a reason proven against real output, never preemptively.
Checks: >
  bugprone-*,
  cert-*,
  hicpp-signed-bitwise,
  clang-analyzer-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -misc-include-cleaner,
  -misc-use-internal-linkage
# Imported individually from the otherwise-disabled hicpp family (2026-08):
# - hicpp-signed-bitwise: shifts and masks on signed operands are this
#   codebase's core UB risk (bit-packing codecs); the check fired usefully
#   on real M2 code (signed XOR accumulator). Enforces unsigned literals
#   (1u << n) in mask math — accepted cost.
# Disabled with cause (proven on real output, 2026-08):
# - bugprone-easily-swappable-parameters: fires "2 adjacent parameters of
#   similar type ('PyObject *')" on every CPython calling convention —
#   METH_O is (PyObject *self, PyObject *arg) by ABI — and even on
#   Python.h's own inline functions (PyObject_CallMethodOneArg). The
#   signatures are the platform's, not ours to reorder.
# - misc-include-cleaner: demands per-symbol internal headers; CPython's
#   contract is the opposite — include Python.h only, never its internals.
# - misc-use-internal-linkage: wants PyInit__core static, which would hide
#   it from dlsym and break importing entirely; export is the ABI contract.
# Only diagnose our code, not Python.h internals.
HeaderFilterRegex: 'src/radixly/.*'
# Generated tables are exempt, mirroring .clang-format-ignore: they can
# only be regenerated, never hand-fixed, and a future ruleset diagnosing
# a 2000-line initializer would otherwise turn CI red on machine output.
ExcludeHeaderFilterRegex: '.*/_tables\.h'
WarningsAsErrors: '*'
CheckOptions:
  # Positive integer literals (and enum constants, which are int by language
  # rule) are harmless in bit expressions; the check's target is signed
  # VARIABLES, where shifts can hit UB. Without this, hicpp-signed-bitwise
  # and modernize-macro-to-enum give contradictory orders about constants.
  hicpp-signed-bitwise.IgnorePositiveIntegerLiterals: true
